rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == "niclasaustermann1607@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /users/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow create: if request.auth != null && request.auth.uid == uid
        && !request.resource.data.keys().hasAny(["blocked", "role"]);
      allow update: if isAdmin() || (request.auth != null && request.auth.uid == uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["blocked", "role"]));
      allow delete: if (request.auth != null && request.auth.uid == uid) || isAdmin();
    }
  }
}
